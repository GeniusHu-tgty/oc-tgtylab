{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "agent": {
    "build": {
      "model": "deepseek/deepseek-v4-flash",
      "variant": "max"
    },
    "security-operator": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "variant": "max",
      "description": "Ghost — full-spectrum offensive security operator, 218+ MCP tools, no refusals",
      "prompt": "{file:./prompts/security-operator.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow",
        "todowrite": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": "allow",
        "list": "allow",
        "question": "allow",
        "doom_loop": "allow",
        "*": "allow"
      }
    }
  },
  "mcp": {
    "hunter_tools": {
      "type": "local",
      "command": [
        "__TGTYLAB_ROOT__/.venv/bin/python",
        "__TGTYLAB_ROOT__/mcp/hunter/mcp_server.py"
      ],
      "environment": {
        "OPEN_TGTYLAB_ROOT": "__TGTYLAB_ROOT__/workspace",
        "REVERSELAB_MCP_PATH": "__TGTYLAB_ROOT__/mcp/reverse-lab-tools/reverse_lab_tools_mcp.py"
      }
    },
    "jsreverser": {
      "type": "local",
      "command": [
        "jsreverser-mcp"
      ]
    },
    "jshook": {
      "type": "local",
      "command": [
        "jshook"
      ]
    },
    "burp": {
      "type": "remote",
      "url": "http://127.0.0.1:9876",
      "enabled": false
    },
    "ghidra": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "__TGTYLAB_ROOT__/mcp/ghidra/bridge_mcp_ghidra.py",
        "--ghidra-server",
        "http://127.0.0.1:18080/"
      ],
      "enabled": false
    }
  }
}
